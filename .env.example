# ─────────────────────────────────────────────────────────────────────────────
# Hybrid Scam Shield — Firebase configuration
#
# Copy this file to `.env` and fill in the values from the Firebase console:
#   Project settings → General → Your apps → Web app → SDK setup and configuration
#
# Nothing here is a server secret: the Firebase Web API key is a public project
# identifier. Real protection comes from App Check + Firebase Security Rules, and
# the AI Logic API key restrictions you set in Google Cloud.
# NEVER put an App Check debug token, a service-account key, or a Gemini API key
# in this file or anywhere in the bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Required — the web app registration of your Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional — only needed for Storage / Analytics elsewhere in the project.
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── App Check (strongly recommended, required for production) ───────────────
# reCAPTCHA Enterprise site key registered for your Firebase web app.
# For the Chrome extension build, register the extension origin
# (chrome-extension://<your-extension-id>) on the same key, or use a second key.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Set to `true` ONLY while developing locally to print a debug token in the
# browser console. Register that token in Firebase Console → App Check → Apps →
# Manage debug tokens. Never ship a build with this enabled.
VITE_FIREBASE_APP_CHECK_DEBUG=false

# ─── Models ─────────────────────────────────────────────────────────────────
# Cloud model used for Tier 2 (deep analysis) and for on-device fallback.
# Do NOT use the retired Gemini 2.5 family.
VITE_AI_CLOUD_MODEL=gemini-3.5-flash-lite
